{
  "name": "yieldvitals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint tests vite.config.js playwright.config.js eslint.config.js",
    "format:check": "prettier --check tests vite.config.js playwright.config.js eslint.config.js package.json",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:i18n": "vitest run tests/unit/i18n.test.js",
    "check": "npm run lint && npm run format:check && npm run test:unit && npm run test:i18n && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.39.1",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  }
}
